module System.Localization;

struct LocalizedString {
    key_hash: u64,
    utf8_ptr: u64
}

public fn get_text(hash: u64, table: [LocalizedString; 128]) -> u64 {
    let mut i: u64 = 0;
    while i < 128 {
        if table[i].key_hash == hash { return table[i].utf8_ptr; }
        i += 1;
    }
    return 0;
}
