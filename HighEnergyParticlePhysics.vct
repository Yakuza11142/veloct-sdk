#![feature(portable_simd)] // Unlocks native hardware SIMD vector extension instruction sets

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;
use std::simd::f32x4;

// ============================================================================
// 1. DATA CORE: HARDWARE-ALIGNED RELATIVISTIC SOAS (Structure-of-Arrays)
// ============================================================================

/// High-density packed subatomic particle block tracking 4 particles concurrently.
/// Cache-aligned to 64 bytes to eliminate false-sharing across parallel worker cores.
#[derive(Debug, Clone, Copy)]
#[repr(C, align(64))]
pub struct SubatomicParticleSoA4 {
    pub pos_x: [f32; 4], pub pos_y: [f32; 4], pub pos_z: [f32; 4],
    pub mom_x: [f32; 4], pub mom_y: [f32; 4], pub mom_z: [f32; 4],
    pub charge:    [f32; 4],
    pub rest_mass: [f32; 4],
}

/// System context containing unchanging global physical constants.
#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct RelativisticSystemContext {
    pub simulation_step_id: u64,
    pub speed_of_light_mps: f32, // $2.99792458 \times 10^8$ m/s
    pub speed_of_light_sq:  f32, // $c^2$
}

// ============================================================================
// 2. THE LOCK-FREE RECENT STATE REGISTRY (URCU)
// ============================================================================

pub struct ConcurrentAvionicsRegistry {
    active_context_ptr: AtomicPtr<RelativisticSystemContext>,
}

impl ConcurrentAvionicsRegistry {
    pub fn new() -> Self {
        let default_context = Box::new(RelativisticSystemContext {
            simulation_step_id: 0,
            speed_of_light_mps: 299792458.0,
            speed_of_light_sq:  8.9875518e16,
        });
        Self { active_context_ptr: AtomicPtr::new(Box::into_raw(default_context)) }
    }

    #[inline(always)]
    pub fn read_context_snapshot(&self) -> Arc<RelativisticSystemContext> {
        let raw_ptr = self.active_context_ptr.load(Ordering::Acquire);
        unsafe { Arc::new(*raw_ptr) }
    }

    pub fn commit_context_swap(&self, fresh_context: RelativisticSystemContext) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_context));
        let old_raw_ptr = self.active_context_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear out historical allocations
        }
    }
}

impl Drop for ConcurrentAvionicsRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_context_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING RELATIVISTIC LORENTZ SOLVER CORE (BORIS STEP EXTENSION)
// ============================================================================

pub struct UltimateRelativisticEngine;

impl UltimateRelativisticEngine {
    /// PARALLEL VECTORIZED LORENTZ DISPATCH (Updates 4 particles simultaneously)
    /// Employs a mass-invariant velocity transform to prevent division-by-zero anomalies.
    #[inline(always)]
    pub fn step_lorentz_motion_x4(
        &self,
        context_registry: &ConcurrentAvionicsRegistry,
        active_chunk: &mut SubatomicParticleSoA4,
        e_field_xyz: [f32; 3],
        b_field_xyz: [f32; 3],
        dt: f32
    ) {
        let ctx = context_registry.read_context_snapshot();
        let safe_epsilon = f32x4::splat(0.0001);
        let dt_vec = f32x4::splat(dt);

        // 1. Load active tracking streams directly into 128-bit hardware registers
        let mut px = f32x4::from_slice(&active_chunk.mom_x);
        let mut py = f32x4::from_slice(&active_chunk.mom_y);
        let mut pz = f32x4::from_slice(&active_chunk.mom_z);

        let mut x = f32x4::from_slice(&active_chunk.pos_x);
        let mut y = f32x4::from_slice(&active_chunk.pos_y);
        let mut z = f32x4::from_slice(&active_chunk.pos_z);

        let q = f32x4::from_slice(&active_chunk.charge);
        let m0 = f32x4::from_slice(&active_chunk.rest_mass);

        // 2. Compute the exact Relativistic Gamma Factor branchlessly from momentum space
        // $\gamma = \sqrt{1 + \frac{p^2}{m_0^2 c^2}}$ rearranged to avoid $m_0 = 0$ singularities:
        // $\gamma m_0 = \sqrt{m_0^2 + p^2/c^2}$
        let p_sq = (px * px) + (py * py) + (pz * pz);
        let c_sq = f32x4::splat(ctx.speed_of_light_sq);
        let m_effective_sq = (m0 * m0) + (p_sq / c_sq);
        let gamma_m0 = m_effective_sq.simd_max(safe_epsilon).simd_sqrt();

        // 3. Resolve True Non-Singular Physical Velocity: $\mathbf{v} = \mathbf{p} / (\gamma m_0)$
        // Completely immune to rest mass zero points (e.g. valid for high-energy photon packets)
        let vx = px / gamma_m0;
        let vy = py / gamma_m0;
        let vz = pz / gamma_m0;

        // 4. Calculate Lorentz Cross-Product Forces: $\mathbf{F} = q \cdot (\mathbf{E} + \mathbf{v} \times \mathbf{B})$
        let ex = f32x4::splat(e_field_xyz[0]);
        let ey = f32x4::splat(e_field_xyz[1]);
        let ez = f32x4::splat(e_field_xyz[2]);

        let bx = f32x4::splat(b_field_xyz[0]);
        let by = f32x4::splat(b_field_xyz[1]);
        let bz = f32x4::splat(b_field_xyz[2]);

        // Cross product components evaluation: $\mathbf{v} \times \mathbf{B}$
        let v_cross_b_x = (vy * bz) - (vz * by);
        let v_cross_b_y = (vz * bx) - (vx * bz);
        let v_cross_b_z = (vx * by) - (vy * bx);

        let lorentz_x = (ex + v_cross_b_x) * q;
        let lorentz_y = (ey + v_cross_b_y) * q;
        let lorentz_z = (ez + v_cross_b_z) * q;

        // 5. Kinematic Step Updates: Update momentum and translate positions
        px += lorentz_x * dt_vec;
        py += lorentz_y * dt_vec;
        pz += lorentz_z * dt_vec;

        x += vx * dt_vec;
        y += vy * dt_vec;
        z += vz * dt_vec;

        // 6. Flush calculations straight back to memory arrays without stack copying
        px.copy_to_slice(&mut active_chunk.mom_x);
        py.copy_to_slice(&mut active_chunk.mom_y);
        pz.copy_to_slice(&mut active_chunk.mom_z);

        x.copy_to_slice(&mut active_chunk.pos_x);
        y.copy_to_slice(&mut active_chunk.pos_y);
        z.copy_to_slice(&mut active_chunk.pos_z);
    }
}

// ============================================================================
// 4. REINFORCED SCIENTIFIC VALIDATION HARNESS
// ============================================================================

fn main() {
    let registry = ConcurrentAvionicsRegistry::new();
    let HPC_engine = UltimateRelativisticEngine;

    // Allocate an initial active particle block holding 4 independent tracking profiles
    let mut beam_chunk = SubatomicParticleSoA4 {
        pos_x: [0.0; 4], pos_y: [0.0; 4], pos_z: [0.0; 4],
        mom_x: [1.5e-19, 0.0, 0.0, 5.0e-22], // Extreme high-velocity momentum scales
        mom_y: [0.0; 4], mom_z: [0.0; 4],
        charge:    [1.6021766e-19, -1.6021766e-19, 0.0, 0.0], // Protons, Electrons, and Photons
        rest_mass: [1.6726219e-27, 9.1093835e-31, 0.0, 0.0], // Massless particles in lanes 2 & 3
    };

    // Environmental field tensors (e.g. localized inside an electromagnetic laser trap)
    let electric_field_vector = [1.0e5, 0.0, 0.0];  // 100,000 V/m
    let magnetic_field_vector = [0.0, 0.0, 2.5];  // 2.5 Tesla magnetic field
    let time_increment_dt = 1.0e-12;               // 1 Picosecond execution step window

    println!("--- High-Throughput SIMD Relativistic Particle Engine Online ---");
    println!("Initial Particle Coordinate Grid (X Axis): {:?}", beam_chunk.pos_x);

    // Compute relativistic transformations parallelly inside 128-bit vector lanes
    HPC_engine.step_lorentz_motion_x4(&registry, &mut beam_chunk, electric_field_vector, magnetic_field_vector, time_increment_dt);

    println!("\nRecalculated Relativistic Space Trajectories Post-Boris Integration Pass:");
    println!("  Lane 0 (High-Speed Proton) - Position X: {:.4e}m (Accelerated under Lorentz fields)", beam_chunk.pos_x[0]);
    println!("  Lane 1 (Relativistic Electron) - Momentum X: {:.4e} kg·m/s (Deflected strongly due to small mass scale)", beam_chunk.mom_x[1]);
    println!("  Lane 2 (Massless Photon Packet) - Position X: {:.4e}m (Safely bypassed mass division singularities!)", beam_chunk.pos_x[2]);
}
