// Filename: veloct_core.vct
// Veloct Ultra-Low-Latency Spatial & Physics Kernel

struct SpatialEntity {
    pos: vec4<f32>,      // xyz: Position, w: Uniform Scale
    rot: vec4<f32>,      // Quaternion (x, y, z, w)
};

struct SphereCollider {
    center_radius: vec4<f32>, // xyz: Center, w: Radius
};

struct RayQuery {
    origin: vec4<f32>,   // xyz: Ray Origin, w: Padding
    dir: vec4<f32>,      // xyz: Normalized Ray Dir, w: Max Distance
};

struct RayHitResult {
    packed_hit_dist: vec4<f32>, // x: Hit Status (1.0/0.0), y: Distance, z,w: Reserved
    hit_pos: vec4<f32>,         // xyz: World Hit Position, w: Unused
    normal: vec4<f32>,          // xyz: Surface Normal, w: Unused
};

@group(0) @binding(0) var<storage, read> entities: array<SpatialEntity>;
@group(0) @binding(1) var<storage, read> colliders: array<SphereCollider>;
@group(0) @binding(2) var<storage, read> rays: array<RayQuery>;
@group(0) @binding(3) var<storage, read_write> results: array<RayHitResult>;

// Branchless SIMD Quaternion Vector Rotation
fn rotate_vector_fast(v: vec3<f32>, q: vec4<f32>) -> vec3<f32> {
    let t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

// Fused Spatial Transform & Ray-Sphere Collision (64-Thread SIMD Workgroup)
@compute @workgroup_size(64, 1, 1)
fn execute_spatial_physics_pass(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= arrayLength(&rays)) {
        return;
    }

    // 1. SIMD Vector Reads
    let ray = rays[idx];
    let entity = entities[idx];
    let collider = colliders[idx];

    // 2. Fused Transform Computation
    let local_sphere_center = collider.center_radius.xyz;
    let radius = collider.center_radius.w * entity.pos.w;
    let world_sphere_center = entity.pos.xyz + rotate_vector_fast(local_sphere_center, entity.rot);

    // 3. Branchless Ray-Sphere Intersect
    let oc = ray.origin.xyz - world_sphere_center;
    let b = dot(oc, ray.dir.xyz);
    let c = dot(oc, oc) - (radius * radius);
    let discriminant = (b * b) - c;

    // Branchless step evaluation (1.0 if hit, 0.0 if miss)
    let is_hit = step(0.0, discriminant);
    let sqrt_disc = sqrt(max(discriminant, 0.0));
    let t = -b - sqrt_disc;

    // Validate distance range (0.0 < t < max_distance)
    let valid_dist = select(0.0, 1.0, t > 0.0 && t < ray.dir.w);
    let final_hit = is_hit * valid_dist;

    let hit_position = ray.origin.xyz + (ray.dir.xyz * t);
    let surface_normal = (hit_position - world_sphere_center) * inverseSqrt(dot(hit_position - world_sphere_center, hit_position - world_sphere_center));

    // 4. Coalesced Memory Write Back
    var out_res: RayHitResult;
    out_res.packed_hit_dist = vec4<f32>(final_hit, select(-1.0, t, final_hit == 1.0), 0.0, 0.0);
    out_res.hit_pos = vec4<f32>(select(vec3<f32>(0.0), hit_position, final_hit == 1.0), 1.0);
    out_res.normal = vec4<f32>(select(vec3<f32>(0.0), surface_normal, final_hit == 1.0), 0.0);

    results[idx] = out_res;
}
