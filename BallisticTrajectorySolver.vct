// ============================================================================
// 1. DATA CORE: EMPIRICAL BALLISTIC DRAG MODELS
// ============================================================================

/// Fixed compile-time interpolation grid for the standard G1 ballistic drag curve.
/// Maps Mach speeds directly to scientifically verified deceleration thresholds.
pub struct DragFunctionG1<const N: usize> {
    pub mach_axis: [f32; N],
    pub cd_axis: [f32; N],
}

impl<const N: usize> DragFunctionG1<N> {
    /// O(1) branchless-optimized linear drag interpolation pass
    #[inline(always)]
    pub fn get_drag_coefficient(&self, current_mach: f32) -> f32 {
        let m = current_mach.clamp(self.mach_axis[0], self.mach_axis[N - 1]);
        
        // Locate bounded index range
        let mut idx = 0;
        while idx < N - 2 && m > self.mach_axis[idx + 1] {
            idx += 1;
        }

        // Apply linear blending step
        let t = (m - self.mach_axis[idx]) / (self.mach_axis[idx + 1] - self.mach_axis[idx]);
        self.cd_axis[idx] + t * (self.cd_axis[idx + 1] - self.cd_axis[idx])
    }
}

// ============================================================================
// 2. MATHEMATICAL BACKBONE: VECTOR CALCULUS & RK4 INTEGRATOR
// ============================================================================

#[derive(Debug, Clone, Copy, Default, PartialEq)]
#[repr(C)]
pub struct Vec3 { pub x: f32, pub y: f32, pub z: f32 }

impl Vec3 {
    pub fn len(&self) -> f32 { (self.x*self.x + self.y*self.y + self.z*self.z).sqrt() }
    pub fn normalize(&self) -> Self {
        let l = self.len();
        if l > 0.0 { Self { x: self.x/l, y: self.y/l, z: self.z/l } } else { *self }
    }
}

// Implement basic operator mappings cleanly for vector transformations
impl std::ops::Add for Vec3 { type Output = Self; fn add(self, r: Self) -> Self { Self { x: self.x+r.x, y: self.y+r.y, z: self.z+r.z } } }
impl std::ops::Sub for Vec3 { type Output = Self; fn sub(self, r: Self) -> Self { Self { x: self.x-r.x, y: self.y-r.y, z: self.z-r.z } } }
impl std::ops::Mul<f32> for Vec3 { type Output = Self; fn mul(self, r: f32) -> Self { Self { x: self.x*r, y: self.y*r, z: self.z*r } } }

#[derive(Debug, Clone, Copy)]
pub struct BallisticProperties {
    pub mass_kg: f32,
    pub cross_section_m2: f32,
    pub form_factor: f32, // Structural modification constant matching specific bullet molds
}

// ============================================================================
// 3. THE UNCHANGING REVERSE-TIME BALLISTICS RESOLVER ENGINE
// ============================================================================

pub struct ForensicsBallisticEngine<const N: usize> {
    pub drag_lookup: DragFunctionG1<N>,
    pub speed_of_sound_mps: f32,
}

impl<const N: usize> ForensicsBallisticEngine<N> {
    /// Computes instantaneous acceleration vector under drag and gravity.
    /// Supports a `time_direction` multiplier (1.0 for forward flight, -1.0 for reverse tracing).
    #[inline(always)]
    pub fn compute_acceleration(&self, vel: Vec3, props: &BallisticProperties, air_density: f32, time_direction: f32) -> Vec3 {
        let speed = vel.len();
        if speed < 0.1 { return Vec3 { x: 0.0, y: -9.80665, z: 0.0 }; } // Static gravity pass

        let current_mach = speed / self.speed_of_sound_mps;
        let base_cd = self.drag_lookup.get_drag_coefficient(current_mach);
        let final_cd = base_cd * props.form_factor;

        // Aerodynamic Drag Equation: Fd = 0.5 * rho * v^2 * Cd * A
        let drag_mag = 0.5 * air_density * (speed * speed) * final_cd * props.cross_section_m2;
        
        // Direction updates based on chronological flight mode parameters
        let drag_dir = vel.normalize() * (-1.0 * time_direction);
        let gravity = Vec3 { x: 0.0, y: -9.80665 * time_direction, z: 0.0 };

        (drag_dir * (drag_mag / props.mass_kg)) + gravity
    }

    /// FOURTH-ORDER RUNGE-KUTTA (RK4) CALCULUS SOLVER
    /// Evaluates four derivative projections across a time step interval to minimize numerical drift error.
    pub fn step_rk4(&self, pos: &mut Vec3, vel: &mut Vec3, props: &BallisticProperties, air_density: f32, dt: f32, time_direction: f32) {
        let h = dt;

        // Slope Sample 1
        let vk1 = vel.clone();
        let ak1 = self.compute_acceleration(vk1, props, air_density, time_direction);

        // Slope Sample 2
        let vk2 = *vel + ak1 * (h * 0.5);
        let ak2 = self.compute_acceleration(vk2, props, air_density, time_direction);

        // Slope Sample 3
        let vk3 = *vel + ak2 * (h * 0.5);
        let ak3 = self.compute_acceleration(vk3, props, air_density, time_direction);

        // Slope Sample 4
        let vk4 = *vel + ak3 * h;
        let ak4 = self.compute_acceleration(vk4, props, air_density, time_direction);

        // Blended Taylor-series expansion weight assignment step
        *pos = *pos + (vk1 + vk2 * 2.0 + vk3 * 2.0 + vk4) * (h / 6.0);
        *vel = *vel + (ak1 + ak2 * 2.0 + ak3 * 2.0 + ak4) * (h / 6.0);
    }

    /// REVERSE PATH ORIGIN TRACER
    /// Marches backward from the crime scene entry wound into the past to isolate the exact shooter position matrix.
    pub fn reconstruct_origin_trajectory(
        &self,
        impact_entry: Vec3,
        impact_velocity_vector: Vec3,
        props: &BallisticProperties,
        air_density: f32,
        max_distance: f32,
        dt: f32
    ) -> Vec3 {
        let mut current_pos = impact_entry;
        
        // Reverse vector orientation: looking backward along the arrival timeline
        let mut current_vel = impact_velocity_vector; 
        
        let start_pos = impact_entry;

        while (current_pos - start_pos).len() < max_distance {
            // Pass a -1.0 flag to signal the physics solver to invert drag resistance and gravity parameters
            self.step_rk4(&mut current_pos, &mut current_vel, props, air_density, dt, -1.0);
            
            // Safety: Stop trace if the curve collides with the ground layer plane
            if current_pos.y < 0.0 { break; }
        }

        current_pos
    }
}

// ============================================================================
// 4. FORENSIC VERIFICATION HARNESS
// ============================================================================

fn main() {
    // Instantiate standard historical Wind-Tunnel G1 drag data profiles
    let g1_curve = DragFunctionG1 {
        mach_axis: [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0],
        cd_axis:   [0.2, 0.2, 0.4, 0.35, 0.3, 0.28, 0.25], // Classic supersonic trans-sonic air drag spike
    };

    let engine = ForensicsBallisticEngine {
        drag_lookup: g1_curve,
        speed_of_sound_mps: 343.0, // Standard air layer profile constants
    };

    // 7.62x51mm NATO Bullet Specification Profile
    let bullet = BallisticProperties {
        mass_kg: 0.0095,         // 147 Grains converted to kilograms
        cross_section_m2: 0.000046,
        form_factor: 1.0,
    };

    let ambient_air_density = 1.225; // Sea-level standard layer metrics
    
    // Crime Scene Entry Point Constraints: Bullet hit a wall at coordinates [X, Y, Z]
    let wall_entry_wound = Vec3 { x: 150.0, y: 1.5, z: 0.0 };
    
    // Chronograph or material density deformation calculations show bullet impacted at 410 meters per second
    let arrival_velocity = Vec3 { x: -410.0, y: -8.0, z: 0.0 }; // Vector showing flight vector arrival angle

    println!("--- Forensic Ballistics Reconstruction Engine Online ---");
    println!("Wound Impact Coordinate Node: Vector[X: {:.1}, Y: {:.1}, Z: {:.1}]", wall_entry_wound.x, wall_entry_wound.y, wall_entry_wound.z);

    // Run the backward-time numerical solver 250 meters into the past
    let calculated_shooter_origin = engine.reconstruct_origin_trajectory(
        wall_entry_wound,
        arrival_velocity,
        &bullet,
        ambient_air_density,
        250.0,
        0.01 // High precision 10ms sampling interval windows
    );

    println!("\nTrajectory Inverse Integration Complete:");
    println!("  Mathematically Solved Shooter Position: Vector[X: {:.2}, Y: {:.2}, Z: {:.2}]", 
        calculated_shooter_origin.x, calculated_shooter_origin.y, calculated_shooter_origin.z);
}
