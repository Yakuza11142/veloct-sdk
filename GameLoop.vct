use std::sync::atomic::{AtomicBool, AtomicPtr, Ordering};
use std::sync::Arc;
use std::thread;
use std::time::Duration;

// ============================================================================
// 1. DATA CORE: HARDWARE-ALIGNED TIMING DESCRIPTORS
// ============================================================================

/// Strict 16-byte memory-aligned layout matching low-level hardware register blocks.
/// Padded out cleanly to eliminate CPU cache line reordering and false sharing.
#[derive(Debug, Clone, Copy, Default, PartialEq)]
#[repr(C, align(16))]
pub struct FrameTimeMetrics {
    pub delta_time_seconds: f32,
    pub total_time_seconds: f64,
    pub global_frame_count: u64,
    pub cycle_timestamp_tsc: u64, // Raw hardware CPU clock cycle token (RDTSC)
}

// ============================================================================
// 2. THE LOCK-FREE RECENT TIMING REGISTRY (URCU)
// ============================================================================

/// A thread-safe, lock-free global engine time container.
/// Thousands of parallel rendering paths, network tickers, and physics workers
/// can query current frame metrics concurrently with absolute zero read latency.
pub struct ConcurrentLifecycleRegistry {
    active_time_ptr: AtomicPtr<FrameTimeMetrics>,
}

impl ConcurrentLifecycleRegistry {
    pub fn new() -> Self {
        let default_time = Box::new(FrameTimeMetrics::default());
        Self {
            active_time_ptr: AtomicPtr::new(Box::into_raw(default_time)),
        }
    }

    /// LOCK-FREE HOT TIME SNAPSHOT READ (Hot Path Worker Read)
    /// Instantly returns an immutable data snapshot reference, bypassing Mutex/RwLock blocking overhead.
    #[inline(always)]
    pub fn acquire_time_snapshot(&self) -> Arc<FrameTimeMetrics> {
        let raw_ptr = self.active_time_ptr.load(Ordering::Acquire);
        // Safety: Pointer is guaranteed valid via atomic release barriers on the swap channel
        unsafe { Arc::new(*raw_ptr) }
    }

    /// ATOMIC AT-RUN-TIME HOT-SWAP (Loop Internal Path)
    /// Commits fresh timing parameters across all execution lines simultaneously.
    pub fn commit_time_swap(&self, fresh_metrics: FrameTimeMetrics) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_metrics));
        let old_raw_ptr = self.active_feed_ptr_swap(new_raw_ptr);
        if !old_raw_ptr.is_null() {
            unsafe {
                let _ = Box::from_raw(old_raw_ptr); // Deallocate historical frame blocks cleanly
            }
        }
    }

    #[inline(always)]
    fn active_feed_ptr_swap(&self, new_ptr: *mut FrameTimeMetrics) -> *mut FrameTimeMetrics {
        self.active_time_ptr.swap(new_ptr, Ordering::Release)
    }
}

impl Drop for ConcurrentLifecycleRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_time_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe {
                let _ = Box::from_raw(raw_ptr);
            }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING HIGH-PRECISION HARDWARE LIFECYCLE CONTROLLER
// ============================================================================

pub struct UltimateEngineLifecycleLoop {
    pub cpu_frequency_hz: f64,    // Baseline processor clock speed to convert cycles into seconds
    pub target_frame_rate_hz: f32, // Target execution frequency limit (e.g., 60.0 or 144.0)
}

impl UltimateEngineLifecycleLoop {
    /// THE UNIVERSAL ENGINE LOOP RUNTIME
    /// Drives system processing threads branchlessly using raw hardware execution metrics.
    pub fn run_orchestration_loop<F>(
        &self,
        registry: Arc<ConcurrentLifecycleRegistry>,
        shutdown_signal: Arc<AtomicBool>,
        mut frame_payload_callback: F,
    ) where
        F: FnMut(f32),
    {
        println!("--- High-Precision Hardware-Clock Engine Loop Active ---");
        
        let target_frame_time_seconds = 1.0 / self.target_frame_rate_hz;
        
        // Query baseline hardware CPU cycle tracking registers directly (takes ~2 nanoseconds)
        let mut last_cycle_stamp = unsafe { std::arch::x86_64::_rdtsc() };
        let mut total_accumulated_time = 0.0f64;
        let mut frame_counter = 0u64;

        while !shutdown_signal.load(Ordering::Relaxed) {
            let current_cycle_stamp = unsafe { std::arch::x86_64::_rdtsc() };
            
            // Calculate absolute clock cycle delta while guarding against overflow conditions
            let cycle_delta = current_cycle_stamp.wrapping_sub(last_cycle_stamp) as f64;
            let elapsed_seconds = cycle_delta / self.cpu_frequency_hz;

            // Framerate Throttle / Cap Guard (Genlock Simulation Layer)
            if elapsed_seconds < target_frame_time_seconds as f64 {
                // Yield the execution thread momentarily to prevent 100% CPU thread starvation spikes
                thread::sleep(Duration::from_micros(250));
                continue;
            }

            // Step 1: Pack computed timing records into our isolated thread frame
            last_cycle_stamp = current_cycle_stamp;
            total_accumulated_time += elapsed_seconds;
            frame_counter += 1;

            let current_frame_metrics = FrameTimeMetrics {
                delta_time_seconds: elapsed_seconds as f32,
                total_time_seconds: total_accumulated_time,
                global_frame_count: frame_counter,
                cycle_timestamp_tsc: current_cycle_stamp,
            };

            // Step 2: Inject timing metrics into our lock-free architecture registry matrix atomically
            registry.commit_time_swap(current_frame_metrics);

            // Step 3: Dispatch structural payload processing worker systems
            frame_payload_callback(elapsed_seconds as f32);
        }
        
        println!("[Engine Loop]: Core lifecycle loop thread clean shutdown complete.");
    }
}

// ============================================================================
// 4. PIPELINE RUNTIME VALIDATION HARNESS
// ============================================================================

fn main() {
    let lifecycle_registry = Arc::new(ConcurrentLifecycleRegistry::new());
    let shutdown_flag = Arc::new(AtomicBool::new(false));

    // Configure engine targeting a 3.5 GHz CPU core profile layout locked to a 60Hz update ceiling
    let engine_loop_kernel = UltimateEngineLifecycleLoop {
        cpu_frequency_hz: 3_500_000_000.0,
        target_frame_rate_hz: 60.0,
    };

    // Spawn an independent concurrent thread simulating an auxiliary subsystem reading engine clocks
    let read_tracker_clone = Arc::clone(&lifecycle_registry);
    let read_shutdown_clone = Arc::clone(&shutdown_flag);
    let parallel_worker_handle = thread::spawn(move || {
        thread::sleep(Duration::from_millis(30)); // Allow loop to populate data tracks
        while !read_shutdown_clone.load(Ordering::Relaxed) {
            let time_snapshot = read_tracker_clone.acquire_time_snapshot();
            if time_snapshot.global_frame_count > 0 {
                println!(
                    "  -> [Asynchronous Subsystem Read]: Frame: #{} | Delta Time: {:.5}s | Total Running: {:.4}s | TSC: {}",
                    time_snapshot.global_frame_count, time_snapshot.delta_time_seconds, time_snapshot.total_time_seconds, time_snapshot.cycle_timestamp_tsc
                );
                break;
            }
            thread::sleep(Duration::from_millis(5));
        }
    });

    // Run the main engine lifecycle orchestrator loop (Simulating a brief 50ms run window before shutdown)
    let loop_registry_ref = Arc::clone(&lifecycle_registry);
    let main_shutdown_ref = Arc::clone(&shutdown_flag);
    
    let mut execution_ticks = 0;
    engine_loop_kernel.run_orchestration_loop(loop_registry_ref, main_shutdown_ref, |dt| {
        // Execute transient subsystem updates (e.g. physics steps, mesh culling, network sync passes)
        execution_ticks += 1;
        if execution_ticks >= 3 {
            shutdown_flag.store(true, Ordering::Relaxed); // Trigger automated termination pass for verification
        }
    });

    parallel_worker_handle.join().unwrap();
    println!("\nEngine Lifecycle Process Successfully Terminated. All registries safely finalized.");
}
