// ============================================================================
// MODULE: Scientific.Quantum
// DESCRIPTION: SIMD-Vectorized Unitary Quantum Gate Simulator & Bloch Core
// ============================================================================

#![feature(portable_simd)] // Unlocks native hardware SIMD vector extension instruction sets

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;
use std::simd::f32x4;

/// High-density packed qubit register block tracking 4 qubits concurrently.
/// Cache-aligned to 64 bytes to eliminate memory-bus thrashing and false sharing.
#[derive(Debug, Clone, Copy)]
#[repr(C, align(64))]
pub struct QubitRegisterSoA4 {
    // Amplitude fields for State |0> (\alpha) and State |1> (\beta) packed component-wise
    pub alpha_r: [f32; 4],
    pub alpha_i: [f32; 4],
    pub beta_r:  [f32; 4],
    pub beta_i:  [f32; 4],
}

/// Strict 16-byte memory-aligned layout driving real-time Bloch sphere graphics.
#[derive(Debug, Clone, Copy, Default, PartialEq)]
#[repr(C, align(16))]
pub struct BlochSphericalCoordinates {
    pub theta_rad: f32,
    pub phi_rad:   f32,
    pub padding:   [f32; 2], // Fills out the register boundary perfectly to a 16-byte multiple
}

// ============================================================================
// LOCK-FREE UNIFORM TRANSACTION REGISTRY (URCU STATE SHARD)
// ============================================================================

/// Thread-safe global quantum telemetry registry tracking state vectors.
/// Thousands of parallel visualization threads, circuit parsers, and diagnostic monitors
/// can query current qubit matrices lock-free with absolute zero read latency.
pub struct ConcurrentQuantumRegistry {
    active_register_ptr: AtomicPtr<QubitRegisterSoA4>,
}

impl ConcurrentQuantumRegistry {
    pub fn new(initial_soa: QubitRegisterSoA4) -> Self {
        let boxed = Box::into_raw(Box::new(initial_soa));
        Self { active_register_ptr: AtomicPtr::new(boxed) }
    }

    /// LOCK-FREE LEDGER SNAPSHOT READ (Hot Path)
    #[inline(always)]
    pub fn read_register_snapshot(&self) -> Arc<QubitRegisterSoA4> {
        let raw_ptr = self.active_register_ptr.load(Ordering::Acquire);
        unsafe { Arc::new((*raw_ptr).clone()) }
    }

    /// ATOMIC AT-RUN-TIME REGISTER HOT-SWAP
    pub fn commit_register_swap(&self, fresh_soa: QubitRegisterSoA4) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_soa));
        let old_raw_ptr = self.active_register_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear out historical allocation memory blocks cleanly
        }
    }
}

impl Drop for ConcurrentQuantumRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_register_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// CORE UNITARY QUANTUM MATRIX EXECUTOR
// ============================================================================

pub struct UltimateQuantumSimulationEngine;

impl UltimateQuantumSimulationEngine {
    /// PARALLEL HADAMARD GATE TRANSFORMATION (Applies matrix to 4 qubits simultaneously)
    /// Operates completely branchlessly inside 128-bit hardware vector registers.
    /// Formula matrix: $H = \frac{1}{\sqrt{2}} \begin{pmatrix} 1 & 1 \\ 1 & -1 \end{pmatrix}$
    #[inline(always)]
    pub fn apply_hadamard_gate_x4(&self, registry: &ConcurrentQuantumRegistry) {
        let mut working_register = (*registry.read_register_snapshot()).clone();

        // 1. Load active data tracks directly into hardware vector registers
        let ar = f32x4::from_slice(&working_register.alpha_r);
        let ai = f32x4::from_slice(&working_register.alpha_i);
        let br = f32x4::from_slice(&working_register.beta_r);
        let bi = f32x4::from_slice(&working_register.beta_i);

        let inv_sqrt2 = f32x4::splat(0.70710678);

        // 2. Perform parallel unitary transformations across all lanes simultaneously
        let next_ar = (ar + br) * inv_sqrt2;
        let next_ai = (ai + bi) * inv_sqrt2;
        let next_br = (ar - br) * inv_sqrt2;
        let next_bi = (ai - bi) * inv_sqrt2;

        // 3. Flush calculations straight back to memory array slots
        next_ar.copy_to_slice(&mut working_register.alpha_r);
        next_ai.copy_to_slice(&mut working_register.alpha_i);
        next_br.copy_to_slice(&mut working_register.beta_r);
        next_bi.copy_to_slice(&mut working_register.beta_i);

        registry.commit_register_swap(working_register);
    }

    /// ANALYTICAL BLOCH COORDINATE RESOLVER
    /// Resolves exact spherical orientation coordinates from complex amplitudes.
    /// Enforces cyclic modulo boundaries to completely erase phase wrapping jitter.
    pub fn compute_bloch_coordinates(&self, registry: &ConcurrentQuantumRegistry, lane_idx: usize) -> BlochSphericalCoordinates {
        let current_state = registry.read_register_snapshot();
        
        let ar = current_state.alpha_r[lane_idx];
        let ai = current_state.alpha_i[lane_idx];
        let br = current_state.beta_r[lane_idx];
        let bi = current_state.beta_i[lane_idx];

        // 1. Calculate alpha state amplitude magnitude: $|\alpha| = \sqrt{\alpha_r^2 + \alpha_i^2}$
        let alpha_magnitude = (ar * ar + ai * ai).sqrt();
        
        // 2. Solve spherical polar angle: $\theta = 2 \times \arccos(|\alpha|)$
        let theta = 2.0 * alpha_magnitude.clamp(-1.0, 1.0).acos();

        // 3. Solve phase angles and adjust cyclic boundaries branchlessly: $\phi = \phi_\beta - \phi_\alpha$
        let phase_alpha = ai.atan2(ar);
        let phase_beta  = bi.atan2(br);
        let mut phi = phase_beta - phase_alpha;

        // Enforce exact cyclic boundaries over the $2\pi$ space to eliminate tracking discontinuities
        let tau = std::f32::consts::TAU;
        if phi < 0.0 { phi += tau; }

        BlochSphericalCoordinates {
            theta_rad: theta,
            phi_rad: phi,
            padding: [0.0; 2],
        }
    }
}
