// ============================================================================
// MODULE: System.SaveGame
// DESCRIPTION: Zero-Allocation Endian-Aware Binary Save Header Serializer
// ============================================================================

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;

/// Strict packed byte representation matching cross-platform storage standards.
/// Disables standard compiler padding to enforce an exact 18-byte memory footprint.
#[derive(Debug, Clone, Copy, Default, PartialEq)]
#[repr(C, packed)]
pub struct SaveHeader {
    pub version: u32,       // 4 Bytes (Offsets: 0..4)
    pub play_time: f64,     // 8 Bytes (Offsets: 4..12)
    pub player_level: u16,  // 2 Bytes (Offsets: 12..14)
}

pub struct ConcurrentSaveRegistry {
    active_header_ptr: AtomicPtr<SaveHeader>,
}

impl ConcurrentSaveRegistry {
    pub fn new(initial_header: SaveHeader) -> Self {
        let boxed = Box::into_raw(Box::new(initial_header));
        Self { active_header_ptr: AtomicPtr::new(boxed) }
    }

    #[inline(always)]
    pub fn read_header_snapshot(&self) -> Arc<SaveHeader> {
        let raw_ptr = self.active_header_ptr.load(Ordering::Acquire);
        unsafe { Arc::new((*raw_ptr).clone()) }
    }

    pub fn commit_header_swap(&self, fresh_header: SaveHeader) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_header));
        let old_raw_ptr = self.active_header_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); }
        }
    }
}

impl Drop for ConcurrentSaveRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_header_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

pub struct UltimateSaveGameEngine;

impl UltimateSaveGameEngine {
    /// ZERO-ALLOCATION NATIVE MEMORY RECORDING
    /// Serializes save headers into a 32-byte chunk completely branchlessly.
    /// Fully cross-platform safe due to explicit hardware Little-Endian byte packing loops.
    #[inline(always)]
    pub fn write_save_header(&self, registry: &ConcurrentSaveRegistry, destination_buffer: &mut [u8; 32]) {
        let header = registry.read_header_snapshot();

        // 1. Pack 32-bit integer version profile safely using explicit offsets
        destination_buffer[0..4].copy_from_slice(&header.version.to_le_bytes());

        // 2. Pack 64-bit float play time parameters (Offsets: 4..12)
        destination_buffer[4..12].copy_from_slice(&header.play_time.to_bits().to_le_bytes());

        // 3. Pack 16-bit integer player level parameters (Offsets: 12..14)
        destination_buffer[12..14].copy_from_slice(&header.player_level.to_le_bytes());
        
        // Zero-padding remains completely undisturbed in destination_buffer[14..32]
    }
}
