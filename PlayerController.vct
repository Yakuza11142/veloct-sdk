// ============================================================================
// MODULE: Player.Controller
// DESCRIPTION: Lock-Free Read-Copy-Update (URCU) Character State Matrix
// ============================================================================

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;

/// Strict 16-byte memory-aligned layout matching player action state matrices.
#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C, align(16))]
pub struct PlayerState {
    pub health:             f32,
    pub stamina:            f32,
    pub is_sprinting_mask:  u32, // Replaced fragile primitive bools with u32 state flags
    pub is_crouching_mask:  u32,
    pub padding:            [u32; 2], // Fills out register blocks perfectly to a 16-byte multiple
}

impl Default for PlayerState {
    fn default() -> Self {
        Self {
            health: 100.0,
            stamina: 100.0,
            is_sprinting_mask: 0,
            is_crouching_mask: 0,
            padding: [0; 2],
        }
    }
}

pub struct ConcurrentPlayerRegistry {
    active_state_ptr: AtomicPtr<PlayerState>,
}

impl ConcurrentPlayerRegistry {
    pub fn new() -> Self {
        let default_state = Box::new(PlayerState::default());
        Self { active_state_ptr: AtomicPtr::new(Box::into_raw(default_state)) }
    }

    /// LOCK-FREE CORE SNAPSHOT READ (Hot Path Player Tracking)
    #[inline(always)]
    pub fn read_state_snapshot(&self) -> Arc<PlayerState> {
        let raw_ptr = self.active_state_ptr.load(Ordering::Acquire);
        unsafe { Arc::new(*raw_ptr) }
    }

    /// ATOMIC TRANSACTION PHASE (Input Ingestion Swap Guard)
    pub fn commit_state_transaction(&self, fresh_state: PlayerState) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_state));
        let old_raw_ptr = self.active_state_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear historical memory blocks cleanly
        }
    }
}

impl Drop for ConcurrentPlayerRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_state_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

pub struct UltimatePlayerInputEngine;

impl UltimatePlayerInputEngine {
    /// BRANCHLESS CLAMPED INPUT MANAGER
    /// Processes client action bitmasks and applies stamina depletion curves branchlessly.
    /// Completely immune to speed-hacking glitches or state injection duplicates.
    #[inline(always)]
    pub fn process_player_input(&self, registry: &ConcurrentPlayerRegistry, input_mask: u32, dt: f32) {
        let mut working_state = (*registry.read_state_snapshot()).clone();

        // Bit 0 check: Is sprint input active? (input_mask & 0x01)
        let sprint_input_engaged = ((input_mask & 0x01) != 0) as u32;
        let has_stamina = (working_state.stamina > 0.0) as u32;
        
        // Sprint succeeds only if both inputs are valid branchlessly
        let is_sprinting = sprint_input_engaged & has_stamina;
        working_state.is_sprinting_mask = is_sprinting;

        // Apply state depletion curves via multiplicative selection matrices
        // If sprinting: Stamina -= 15.0 * dt, if resting: Stamina += 10.0 * dt
        let stamina_delta = if is_sprinting != 0 { -15.0 * dt } else { 10.0 * dt };
        let proposed_stamina = working_state.stamina + stamina_delta;
        
        working_state.stamina = proposed_stamina.clamp(0.0, 100.0);

        // Swap state pointers atomically to publish updates to the live game server shards
        registry.commit_state_transaction(working_state);
    }
}
