// ============================================================================
// MODULE: Commerce.Retail
// DESCRIPTION: GPU-Accelerated Volumetric Retail Heatmap Density Parser
// ============================================================================

// Memory-aligned to strict 16-byte structural boundaries for modern graphics APIs
struct RetailHeatmapParameters {
    uint2 display_resolution;      // Heatmap matrix grid size in pixels (e.g., 32x32)
    uint  total_customer_count;    // Maximum tracking loops ceiling across traffic array (e.g., 128)
    float proximity_cutoff_radius; // Influence radius threshold limits (e.g., 0.1)
};

// ============================================================================
// RESOURCE INPUT/OUTPUT HARDWARE INTERFACES
// ============================================================================

StructuredBuffer<float2>   CustomerPositionMatrix : register(t0); // Active floor traffic count snapshots
RWStructuredBuffer<float>  OutputHeatmapBuffer    : register(u0); // Target density heatmap buffer matrix

// ============================================================================
// THE PEAK COMPUTE KERNEL: BRANCHLESS TRAFFIC DENSITY ESTIMATOR
// ============================================================================

[numthreads(32, 32, 1)] // Optimized 2D Grid block configuration mapping out 1024 cells perfectly
void ComputeRetailTrafficHeatmapKernel(
    uint3 dispatch_id : SV_DispatchThreadID,
    ConstantBuffer<RetailHeatmapParameters> config : register(b0)
) {
    uint2 cell_coords = dispatch_id.xy;
    
    // Safety boundary constraints: prevent unaligned edge memory execution crashes
    if (cell_coords.x >= config.display_resolution.x || cell_coords.y >= config.display_resolution.y) {
        return;
    }

    uint cell_flat_idx = cell_coords.x + (cell_coords.y * config.display_resolution.x);

    // Normalize cell coordinates into a uniform UV layout matrix [0.0 - 1.0]
    float2 cell_uv = (float2)cell_coords / (float2)config.display_resolution;
    
    float accumulated_intensity = 0.0;
    const float safe_epsilon = 0.0001;

    // Step 1: Loop through every active consumer trajectory node branchlessly
    for (uint i = 0; i < config.total_customer_count; i++) {
        float2 customer_pos = CustomerPositionMatrix[i];

        // Solve spatial distance: Distance = length(Customer - Cell)
        float2 delta = cell_uv - customer_pos;
        float current_distance = length(delta);

        // step(a, b) returns 1.0 if b >= a, and 0.0 if b < a.
        // Yields 1.0 if the customer sits inside our spatial tracking proximity circle, 0.0 if safe
        float is_inside_proximity = step(current_distance, config.proximity_cutoff_radius);

        // Compute linear density contribution weights branchlessly
        float falloff_density = (config.proximity_cutoff_radius - current_distance) * 10.0;
        accumulated_intensity += max(0.0, falloff_density) * is_inside_proximity;
    }

    // Step 2: Flush calculations straight back to output VRAM storage buffers branchlessly
    OutputHeatmapBuffer[cell_flat_idx] = min(accumulated_intensity, 1.0);
}
