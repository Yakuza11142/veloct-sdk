use std::sync::Arc;
use std::sync::atomic::{AtomicPtr, Ordering};

// ============================================================================
// 1. DATA CORE: PACKED MEMORY CHUNK
// ============================================================================

/// Memory-aligned enterprise configuration layout.
/// Designed for lightning-fast cache reads across enterprise web nodes.
#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct CommerceSystemConfig {
    pub enterprise_id: u64,
    pub supported_currency_flags: u8, // Bitmask mapping -> 1: NGN, 2: USD, 4: GBP
    pub telemetry_streaming_enabled: bool,
    pub max_data_buffer_mb: u32,
}

// ============================================================================
// 2. THE LOCK-FREE HOT-SWAPPING CONTAINER (RCU PATTERN)
// ============================================================================

/// A thread-safe, infinitely scalable configuration repository.
/// Leverages atomic pointer swapping (Read-Copy-Update) to achieve zero-latency 
/// read operations under extreme multi-threaded transaction volumes.
pub struct EnterpriseConfigRegistry {
    /// Atomic pointer pointing to an immutable heap-allocated config instance
    active_config_ptr: AtomicPtr<CommerceSystemConfig>,
}

impl EnterpriseConfigRegistry {
    /// Initializes the registry with default compilation values
    pub fn new() -> Self {
        let default_config = Box::new(CommerceSystemConfig {
            enterprise_id: 0x8899AABBCCDDEEFF,
            supported_currency_flags: 7, // Binary 0111 -> Supports NGN, USD, GBP
            telemetry_streaming_enabled: true,
            max_data_buffer_mb: 512,
        });

        Self {
            active_config_ptr: AtomicPtr::new(Box::into_raw(default_config)),
        }
    }

    /// LOCK-FREE HOT READ (Hot Path)
    /// Thousands of parallel checkout threads can call this simultaneously.
    /// It completely bypasses Mutex/RwLock blocking mechanics for maximum throughput.
    #[inline(always)]
    pub fn acquire_snapshot(&self) -> Arc<CommerceSystemConfig> {
        // Load the address atomically using relaxed ordering for zero CPU pipeline stalls
        let raw_ptr = self.active_config_ptr.load(Ordering::Relaxed);
        
        // Safety: The pointer is guaranteed to be valid because our update function 
        // cleans up obsolete allocations only after safe boundaries pass.
        unsafe {
            let config_ref = &*raw_ptr;
            // Return an isolated, immutable data snapshot to the checkout thread
            Arc::new(*config_ref)
        }
    }

    /// ATOMIC RUNTIME HOT-SWAP (Management Path)
    /// Allows microservices, administrative dashboards, or file watchers to instantly
    /// inject a new config structure at runtime without stopping a single checkout thread.
    pub fn hot_swap_configuration(&self, new_config: CommerceSystemConfig) {
        let new_raw_ptr = Box::into_raw(Box::new(new_config));

        // Atomically exchange the pointer. The updated configuration becomes visible 
        // to all incoming transaction threads instantly and simultaneously.
        let old_raw_ptr = self.active_config_ptr.swap(new_raw_ptr, Ordering::Release);

        // Deallocate the old memory safely to prevent leak accumulation
        if !old_raw_ptr.is_null() {
            unsafe {
                let _ = Box::from_raw(old_raw_ptr);
            }
        }
    }
}

// Ensure cleanup safety if the server instance shuts down completely
impl Drop for EnterpriseConfigRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_config_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. ENTERPRISE SIMULATION & VALIDATION RUNTIME
// ============================================================================

fn main() {
    // 1. Boot up global configuration registry cluster memory
    let config_registry = EnterpriseConfigRegistry::new();
    println!("--- Enterprise Commerce Engine Config Initialized ---");

    // 2. Simulate standard high-frequency transaction thread reading configuration
    let checkout_snapshot_1 = config_registry.acquire_snapshot();
    println!("[Checkout Thread 1] Reading Active Config:");
    println!("  Enterprise ID : {:#X}", checkout_snapshot_1.enterprise_id);
    println!("  Currency Flags: {}", checkout_snapshot_1.supported_currency_flags);
    println!("  Buffer Size   : {} MB", checkout_snapshot_1.max_data_buffer_mb);

    // 3. Admin updates configurations via dynamic hot-swap (e.g., expanding buffer to 1024MB)
    println!("\n[Admin Service]: Dynamic configuration hot-swap triggered at runtime...");
    let updated_profile = CommerceSystemConfig {
        enterprise_id: 0x8899AABBCCDDEEFF,
        supported_currency_flags: 3, // Dropped GBP support (Binary 0011 -> NGN, USD)
        telemetry_streaming_enabled: false,
        max_data_buffer_mb: 1024, // Dynamically expanded allocation
    };
    
    // Inject changes instantly without locking the transaction server channels
    config_registry.hot_swap_configuration(updated_profile);
    println!("[Admin Service]: Hot-swap successfully committed to memory.");

    // 4. Verification: Future checkout threads immediately consume updated parameters
    let checkout_snapshot_2 = config_registry.acquire_snapshot();
    println!("\n[Checkout Thread 2] Reading Active Config Post-Update:");
    println!("  Enterprise ID : {:#X}", checkout_snapshot_2.enterprise_id);
    println!("  Currency Flags: {} (Expected 3)", checkout_snapshot_2.supported_currency_flags);
    println!("  Buffer Size   : {} MB (Expected 1024)", checkout_snapshot_2.max_data_buffer_mb);
}
