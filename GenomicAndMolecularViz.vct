#![feature(portable_simd)] // Unlocks native hardware SIMD vector extension instruction sets

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;
use std::simd::f32x4;

// ============================================================================
// 1. DATA CORE: HARDWARE-ALIGNED ATOMIC PARTIER SOAS (Structure-of-Arrays)
// ============================================================================

/// High-density packed molecular atom block tracking 4 atoms concurrently.
/// Cache-aligned to 64 bytes to eliminate false sharing across parallel worker nodes.
#[derive(Debug, Clone, Copy)]
#[repr(C, align(64))]
pub struct MolecularAtomSoA4 {
    pub pos_x: [f32; 4],
    pub pos_y: [f32; 4],
    pub pos_z: [f32; 4],
    pub charge: [f32; 4],
    pub atom_type_id: [u32; 4], // 1: Carbon, 2: Hydrogen, 3: Nitrogen, 4: Oxygen
}

/// The underlying immutable profile containing global macromolecular context parameters.
#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct MolecularSystemContext {
    pub simulation_tick_id: u64,
    pub dielectric_constant: f32, // Solvent shielding scaling variable
    pub global_coulomb_constant: f32, // $8.987551792 \times 10^9$ N·m²/C²
}

// ============================================================================
// 2. THE LOCK-FREE RECENT STATE REGISTRY (URCU)
// ============================================================================

pub struct ConcurrentMolecularRegistry {
    active_context_ptr: AtomicPtr<MolecularSystemContext>,
}

impl ConcurrentMolecularRegistry {
    pub fn new() -> Self {
        let default_context = Box::new(MolecularSystemContext {
            simulation_tick_id: 0,
            dielectric_constant: 1.0, // Free space vacuum insulation defaults
            global_coulomb_constant: 8.9875518e9,
        });
        Self { active_context_ptr: AtomicPtr::new(Box::into_raw(default_context)) }
    }

    #[inline(always)]
    pub fn read_context_snapshot(&self) -> Arc<MolecularSystemContext> {
        let raw_ptr = self.active_context_ptr.load(Ordering::Acquire);
        unsafe { Arc::new(*raw_ptr) }
    }

    pub fn commit_context_swap(&self, fresh_context: MolecularSystemContext) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_context));
        let old_raw_ptr = self.active_context_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear out historical frame allocations
        }
    }
}

impl Drop for ConcurrentMolecularRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_context_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING MOLECULAR KINEMATICS ACCELERATOR (SIMD COULOMB CORE)
// ============================================================================

pub struct UltimateBiochemicalDataEngine;

impl UltimateBiochemicalDataEngine {
    /// PARALLEL VECTORIZED ELECTROSTATIC FORCE SOLVER (Processes 4 atom pairs simultaneously)
    /// Computes spatial displacement steps, executes high-speed inverse-square tracking,
    /// and flushes resulting force vectors branchlessly with zero heap allocation.
    #[inline(always)]
    pub fn compute_electrostatic_forces_x4(
        &self,
        context_registry: &ConcurrentMolecularRegistry,
        atom_target_a: &MolecularAtomSoA4,
        atom_block_b: &MolecularAtomSoA4,
        out_force_x: &mut [f32; 4],
        out_force_y: &mut [f32; 4],
        out_force_z: &mut [f32; 4],
    ) {
        let ctx = context_registry.read_context_snapshot();
        let safe_epsilon = f32x4::splat(0.0001);

        // 1. Load active data tracks directly into 128-bit hardware vector registers
        let ax = f32x4::splat(atom_target_a.pos_x[0]);
        let ay = f32x4::splat(atom_target_a.pos_y[0]);
        let az = f32x4::splat(atom_target_a.pos_z[0]);
        let a_charge = f32x4::splat(atom_target_a.charge[0]);

        let bx = f32x4::from_slice(&atom_block_b.pos_x);
        let by = f32x4::from_slice(&atom_block_b.pos_y);
        let b_z = f32x4::from_slice(&atom_block_b.pos_z);
        let b_charge = f32x4::from_slice(&atom_block_b.charge);

        // 2. Compute relative spatial displacement vectors: d = B - A
        let dx = bx - ax;
        let dy = by - ay;
        let dz = b_z - az;

        // 3. Calculate distance squared parameters: $r^2 = dx^2 + dy^2 + dz^2$
        let dist_sq = ((dx * dx) + (dy * dy) + (dz * dz)).simd_max(safe_epsilon);

        // 4. ELITE FAST INVERSE CUBE VECTORIZATION METHOD
        // Instead of dividing distance by distance-squared, we perform a direct hardware inverse-square root pass:
        // $inv\_dist = 1 / \sqrt{r^2}$ -> $inv\_dist\_cube = inv\_dist^3$
        let inv_dist = dist_sq.simd_sqrt().reciprocal();
        let inv_dist_cube = inv_dist * inv_dist * inv_dist;

        // 5. ATOMIC MATRIX COULOMB GRADIENT CALCULATION
        // $F = k_e \times \frac{q_a \times q_b}{\epsilon_r} \times \frac{\mathbf{d}}{r^3}$
        let charge_product = a_charge * b_charge;
        let force_scalar_base = f32x4::splat(ctx.global_coulomb_constant / ctx.dielectric_constant) * charge_product;
        
        let final_force_magnitude = force_scalar_base * inv_dist_cube;

        // Resolve absolute force vectors component-wise branchlessly
        let fx = dx * final_force_magnitude;
        let fy = dy * final_force_magnitude;
        let fz = dz * final_force_magnitude;

        // 6. Flush calculations straight back to memory buffers without allocations
        fx.copy_to_slice(out_force_x);
        fy.copy_to_slice(out_force_y);
        fz.copy_to_slice(out_force_z);
    }
}

// ============================================================================
// 4. MOLECULAR DYNAMICS VALIDATION ENGINE HARNESS
// ============================================================================

fn main() {
    let molecular_registry = ConcurrentMolecularRegistry::new();
    let md_solver = UltimateBiochemicalDataEngine;

    // Allocate target atom (e.g. Carbon atom anchored at origin center line)
    let atom_alpha = MolecularAtomSoA4 {
        pos_x: [0.0; 4], pos_y: [0.0; 4], pos_z: [0.0; 4],
        charge: [1.0; 4], // Normalized positive elementary test charge unit
        atom_type_id: [1; 4],
    };

    // Allocate adjacent neighbor array tracking 4 independent Oxygen ions concurrently
    let adjacent_oxygen_block = MolecularAtomSoA4 {
        pos_x: [1.0e-9, -1.0e-9, 2.5e-9, 0.0], // Nano-meter scale coordinate tracking
        pos_y: [0.0; 4],
        pos_z: [0.0; 4],
        charge: [-2.0, -2.0, -2.0, -2.0], // Double negative ionic charges
        atom_type_id: [4; 4],
    };

    let mut fx_out = [0.0f32; 4];
    let mut fy_out = [0.0f32; 4];
    let mut fz_out = [0.0f32; 4];

    println!("--- High-Throughput SIMD Molecular Dynamics Engine Online ---");
    println!("Ingesting Nano-Scale Base-Pair Particle Clusters Matrix...");

    // Execute the parallelized vector electrostatic force check pass
    md_solver.compute_electrostatic_forces_x4(
        &molecular_registry,
        &atom_alpha,
        &adjacent_oxygen_block,
        &mut fx_out,
        &mut fy_out,
        &mut fz_out,
    );

    println!("\nRecalculated Electrostatic Force Tensors (Newtons):");
    println!("  Pair 0 (1nm Distance East)  - Force X: {:.4e}", fx_out[0]);
    println!("  Pair 1 (1nm Distance West)  - Force X: {:.4e} (Opposing vector direction)", fx_out[1]);
    println!("  Pair 2 (2.5nm Dist, Attenuated) - Force X: {:.4e} (Diminished by Inverse-Square Law)", fx_out[2]);
    println!("  Pair 3 (Safety Guarded Lane) - Force X: {:.4e} (Prevented division-by-zero anomaly)", fx_out[3]);
}
