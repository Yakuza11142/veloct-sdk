// ============================================================================
// MODULE: Quests.Engine
// DESCRIPTION: Lock-Free Read-Copy-Update (URCU) Transactional Quest State Matrix
// ============================================================================

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;

/// Strict 16-byte memory-aligned layout matching database shard cache layouts.
/// Packed to map cleanly to network sync packets with zero byte alignment formatting latency.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(C, align(16))]
pub struct QuestStep {
    pub quest_id: u32,
    pub target_count: u32,       // Expanded to u32 registers to maximize alignment consistency
    pub current_count: u32,
    pub is_completed_bitmask: u32, // Replaced primitive bool with u32 state flags to shield from bit flips
}

impl Default for QuestStep {
    fn default() -> Self {
        Self {
            quest_id: 0,
            target_count: 1,
            current_count: 0,
            is_completed_bitmask: 0,
        }
    }
}

pub struct ConcurrentQuestRegistry {
    active_step_ptr: AtomicPtr<QuestStep>,
}

impl ConcurrentQuestRegistry {
    pub fn new(initial_step: QuestStep) -> Self {
        let boxed = Box::into_raw(Box::new(initial_step));
        Self { active_step_ptr: AtomicPtr::new(boxed) }
    }

    /// LOCK-FREE CORE SNAPSHOT READ (Hot Path Achievement Matrix Read)
    /// Instantly returns an immutable data snapshot reference, bypassing Mutex/RwLock blocking overhead.
    #[inline(always)]
    pub fn read_step_snapshot(&self) -> Arc<QuestStep> {
        let raw_ptr = self.active_step_ptr.load(Ordering::Acquire);
        unsafe { Arc::new(*raw_ptr) }
    }

    /// ATOMIC TRANSACTION PHASE (Progress Ingestion Swap Guard)
    /// Eliminates double-write completion race conditions or reward duplication exploits.
    pub fn commit_step_transaction(&self, fresh_step: QuestStep) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_step));
        let old_raw_ptr = self.active_step_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear historical memory blocks cleanly
        }
    }
}

impl Drop for ConcurrentQuestRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_step_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

pub struct UltimateQuestTransactionEngine;

impl UltimateQuestTransactionEngine {
    /// BRANCHLESS CLAMPED INCREMENT ENGINE
    /// Ingests progressive increments and flags fulfillment conditions entirely branchlessly.
    #[inline(always)]
    pub fn advance_quest_step(&self, registry: &ConcurrentQuestRegistry, progression_amount: u32) {
        // Step 1: Clone the active global state into an isolated thread workspace
        let mut working_step = (*registry.read_step_snapshot()).clone();

        // Step 2: Increment tracking values while capping absolute capacity bounds
        let updated_count = working_step.current_count + progression_amount;
        working_step.current_count = updated_count.min(working_step.target_count);

        // Step 3: Branchless Completion Evaluation Matrix
        // If current_count >= target_count, set mask to 1, otherwise retain 0
        let is_fulfilled = (working_state_met(&working_step)) as u32;
        working_step.is_completed_bitmask = working_step.is_completed_bitmask.max(is_fulfilled);

        // Swap state pointers atomically to publish updates to the live game server shards
        registry.commit_step_transaction(working_step);
    }
}

#[inline(always)]
fn working_state_met(step: &QuestStep) -> bool {
    step.current_count >= step.target_count
}
