#![feature(portable_simd)] // Unlocks native hardware SIMD vector extension instruction sets

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;
use std::simd::{u16x4, cmp::SimdPartialOrd};

// ============================================================================
// 1. DATA CORE: HARDWARE-ALIGNED CONTIGUOUS SOAS (Structure-of-Arrays)
// ============================================================================

/// High-density packed user interface block tracking 4 layout slots concurrently.
/// Cache-aligned to 64 bytes to eliminate false sharing across parallel worker nodes.
#[derive(Debug, Clone, Copy)]
#[repr(C, align(64))]
pub struct HudSlotLayoutSoA4 {
    pub min_x: [u16; 4],
    pub max_x: [u16; 4],
    pub min_y: [u16; 4],
    pub max_y: [u16; 4],
    
    /// Bitmask configuration tracking hover states: 1.0 = Hovered/Inside, 0.0 = Clear/Outside
    pub hover_state_mask: [f32; 4],
}

/// The underlying immutable configuration tracking the global cursor positioning node.
#[derive(Debug, Clone, Copy, Default, PartialEq)]
#[repr(C)]
pub struct PointerTelemetryContext {
    pub cursor_id: u32,
    pub mouse_x: u16,
    pub mouse_y: u16,
    pub system_activation_bit: u32, // Global master tracking override block
}

// ============================================================================
// 2. THE LOCK-FREE RECENT CONTEXT REGISTRY (URCU)
// ============================================================================

/// Thread-safe global UI input and spatial tracking repository.
/// Thousands of independent rendering worker passes, cursor sensors, and update pools 
/// can query current mouse positions lock-free with absolute zero read latency.
pub struct ConcurrentUiRegistry {
    active_context_ptr: AtomicPtr<PointerTelemetryContext>,
}

impl ConcurrentUiRegistry {
    pub fn new(initial_context: PointerTelemetryContext) -> Self {
        let boxed = Box::into_raw(Box::new(initial_context));
        Self { active_context_ptr: AtomicPtr::new(boxed) }
    }

    /// LOCK-FREE TELEMETRY SNAPSHOT READ (Render Thread Hot Path)
    #[inline(always)]
    pub fn read_context_snapshot(&self) -> Arc<PointerTelemetryContext> {
        let raw_ptr = self.active_context_ptr.load(Ordering::Acquire);
        unsafe { Arc::new(*raw_ptr) }
    }

    pub fn commit_context_swap(&self, fresh_context: PointerTelemetryContext) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_context));
        let old_raw_ptr = self.active_context_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear historical memory allocations
        }
    }
}

impl Drop for ConcurrentUiRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_context_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING SPATIAL INGESTION CORE (SIMD INTERSECTION SOLVER)
// ============================================================================

pub struct UltimateUiHitEngine;

impl UltimateUiHitEngine {
    /// PARALLEL VECTORIZED BOUNDING BOX EVALUATOR (Updates 4 slots simultaneously)
    /// Processes coordinate containment checks parallelly across 128-bit hardware SIMD lanes.
    /// Completely branchless; eliminates software pipeline stalls across dense inventory grids.
    #[inline(always)]
    pub fn evaluate_grid_hover_matrix_x4(
        &self,
        context_registry: &ConcurrentUiRegistry,
        active_chunk: &mut HudSlotLayoutSoA4
    ) {
        let ctx = context_registry.read_context_snapshot();

        // 1. Load active element data boundaries directly into hardware vector registers
        let x_min = u16x4::from_slice(&active_chunk.min_x);
        let x_max = u16x4::from_slice(&active_chunk.max_x);
        let y_min = u16x4::from_slice(&active_chunk.min_y);
        let y_max = u16x4::from_slice(&active_chunk.max_y);

        // 2. Broadcast cursor tracking parameters across vector lanes
        let mx = u16x4::splat(ctx.mouse_x);
        let my = u16x4::splat(ctx.mouse_y);

        // 3. Branchless Vector Intersection Pass: Check if cursor cuts inside box dimensions
        // Generates binary masks: -1 if condition is satisfied, 0 if false
        let inside_x = mx.simd_ge(x_min) & mx.simd_le(x_max);
        let inside_y = my.simd_ge(y_min) & my.simd_le(y_max);
        
        // Combine axis metrics to isolate final intersections
        let valid_hit_bits = inside_x & inside_y;
        
        // Convert the integer vector mask cleanly into floating point multipliers for the graphics pipeline
        let final_mask = valid_hit_bits.to_int().cast::<f32>();

        // 4. ATOMIC DATA INTROJECTION FLUSH
        final_mask.copy_to_slice(&mut active_chunk.hover_state_mask);
    }
}

// ============================================================================
// 4. HIGH-SCALE INFRASTRUCTURE VALIDATION HARNESS
// ============================================================================

fn main() {
    let ui_input_registry = ConcurrentUiRegistry::new(PointerTelemetryContext {
        cursor_id: 101,
        mouse_x: 45, mouse_y: 22, // Cursor positioned precisely inside local layout bounds
        system_activation_bit: 1,
    });

    let hit_engine = UltimateUiHitEngine;

    // Allocate an initial active UI segment tracking 4 slots concurrently
    let mut inventory_ui_block = HudSlotLayoutSoA4 {
        min_x:,
        max_x:, // Slot 0 and Slot 3 envelop X = 45 coordinate rules
        min_y:,
        max_y:, // Slot 0 and Slot 3 envelop Y = 22 coordinate rules
        
        hover_state_mask: [0.0; 4], // Clear all hover markers initially
    };

    println!("--- High-Throughput ECS SIMD User Interface Hit Engine Online ---");
    println!("Initial Slot Hover Status Masks: {:?}", inventory_ui_block.hover_state_mask);

    // Compute interface updates parallelly inside hardware SIMD registers
    hit_engine.evaluate_grid_hover_matrix_x4(&ui_input_registry, &mut inventory_ui_block);

    println!("\nRecalculated Simulation Metrics Post Vector Hit Pass:");
    println!("  Slot 0 (Active Invariant Target) - Hovered: {} (Cursor successfully tracked inside)", inventory_ui_block.hover_state_mask != 0.0);
    println!("  Slot 1 (Adjacent Item Grid Node) - Hovered: {} (Cursor sits safely outside range bounds)", inventory_ui_block.hover_state_mask != 0.0);
    println!("  Slot 3 (Stacked Overlay Element) - Hovered: {} (Overlapping geometry intersection verified)", inventory_ui_block.hover_state_mask != 0.0);
}
