#![feature(portable_simd)] // Unlocks native hardware SIMD vector extension instruction sets

use std::simd::f32x4;
use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;

// ============================================================================
// 1. DATA CORE: HARDWARE-ALIGNED CONTIGUOUS ROBOTIC ARM STATE
// ============================================================================

/// Strict 16-byte memory-aligned vector tracking 6 joint parameters simultaneously.
/// Grouped in a Structure-of-Arrays (SoA) layout mapped across dual SIMD blocks (4+2 padding) 
/// to eliminate memory-bus layout alignment overhead.
#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C, align(16))]
pub struct JointStateBlock6 {
    pub angles_0_3:     [f32; 4], pub angles_4_5:     [f32; 4], // Index 2 & 3 in block 2 serve as zero padding
    pub limits_min_0_3: [f32; 4], pub limits_min_4_5: [f32; 4],
    pub limits_max_0_3: [f32; 4], pub limits_max_4_5: [f32; 4],
}

/// Compact representation of a 3D coordinate transform matrix.
#[derive(Debug, Clone, Copy, Default, PartialEq)]
#[repr(C, align(16))]
pub struct TransformMat4 {
    pub r0: [f32; 4], pub r1: [f32; 4], pub r2: [f32; 4], pub r3: [f32; 4],
}

#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct RoboticArmProfile {
    pub manipulator_id: u32,
    pub ee_target_x: f32, pub ee_target_y: f32, pub ee_target_z: f32,
    pub control_loop_status: u32, // Bit 0: AutonomyActive, Bit 1: SingularityWarning
}

// ============================================================================
// 2. THE LOCK-FREE RECENT STATE REGISTRY (URCU)
// ============================================================================

pub struct ConcurrentRoboticsRegistry {
    active_profile_ptr: AtomicPtr<RoboticArmProfile>,
}

impl ConcurrentRoboticsRegistry {
    pub fn new(initial_profile: RoboticArmProfile) -> Self {
        let boxed = Box::into_raw(Box::new(initial_profile));
        Self { active_profile_ptr: AtomicPtr::new(boxed) }
    }

    #[inline(always)]
    pub fn read_profile_snapshot(&self) -> Arc<RoboticArmProfile> {
        let raw_ptr = self.active_profile_ptr.load(Ordering::Acquire);
        unsafe { Arc::new(*raw_ptr) }
    }

    pub fn commit_profile_swap(&self, fresh_profile: RoboticArmProfile) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_profile));
        let old_raw_ptr = self.active_profile_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear out historical runtime allocations
        }
    }
}

impl Drop for ConcurrentRoboticsRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_profile_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING SPATIAL 6-DOF KINEMATICS MATRIX CORE
// ============================================================================

pub struct UltimateKinematicsEngine {
    // Standard Denavit-Hartenberg Structural Parameters (Link lengths d and a)
    pub dh_link_lengths_d: [f32; 6],
    pub dh_link_offsets_a: [f32; 6],
}

impl UltimateKinematicsEngine {
    /// 3D SPATIAL FORWARD KINEMATICS CHAIN
    /// Resolves end-effector transformations by alternating orthogonal joint axes coordinates.
    pub fn compute_forward_kinematics(&self, joints: &JointStateBlock6) -> TransformMat4 {
        let mut out_matrix = TransformMat4 {
            r0: [1.0, 0.0, 0.0, 0.0], r1: [0.0, 1.0, 0.0, 0.0],
            r2: [0.0, 0.0, 1.0, 0.0], r3: [0.0, 0.0, 0.0, 1.0],
        };

        // Enforce physical constraints branchlessly using SIMD registers
        let ang_0_3 = f32x4::from_slice(&joints.angles_0_3).simd_clamp(f32x4::from_slice(&joints.limits_min_0_3), f32x4::from_slice(&joints.limits_max_0_3));
        let ang_4_5 = f32x4::from_slice(&joints.angles_4_5).simd_clamp(f32x4::from_slice(&joints.limits_min_4_5), f32x4::from_slice(&joints.limits_max_4_5));

        let mut clamped_angles = [0.0f32; 6];
        ang_0_3.copy_to_slice(&mut clamped_angles[0..4]);
        clamped_angles[4] = ang_4_5[0];
        clamped_angles[5] = ang_4_5[1];

        // Process spatial kinematic chains alternating Yaw, Pitch, and Roll axes
        for i in 0..6 {
            let theta = clamped_angles[i];
            let cos_t = theta.cos();
            let sin_t = theta.sin();
            let d = self.dh_link_lengths_d[i];
            let a = self.dh_link_offsets_a[i];

            // Reconstruct a true spatial transform frame matrix layout step
            // Alternates joint rotation axis types mathematically based on index tracking states
            let local_frame = if i % 2 == 0 {
                // Alternating Axis A: Local Joint Yaw + Translation Matrix
                TransformMat4 {
                    r0: [cos_t, -sin_t, 0.0, a],
                    r1: [sin_t,  cos_t, 0.0, 0.0],
                    r2: [0.0,    0.0,   1.0, d],
                    r3: [0.0,    0.0,   0.0, 1.0],
                }
            } else {
                // Alternating Axis B: Local Joint Pitch + Translation Matrix
                TransformMat4 {
                    r0: [cos_t,  0.0, sin_t, a],
                    r1: [0.0,    1.0, 0.0,   0.0],
                    r2: [-sin_t, 0.0, cos_t, d],
                    r3: [0.0,    0.0, 0.0,   1.0],
                }
            };

            out_matrix = self.multiply_transforms(&out_matrix, &local_frame);
        }

        out_matrix
    }

    /// SPATIAL JACOBIAN TRANSPOSE INVERSE KINEMATICS STEP
    /// Projects task-space 3D errors into joint-space corrections via the Jacobian Transpose matrix.
    pub fn compute_ik_step_jacobian(
        &self,
        registry: &ConcurrentRoboticsRegistry,
        joints: &mut JointStateBlock6,
        current_ee_pos: [f32; 3],
        step_size_lambda: f32,
    ) {
        let ctx = registry.read_profile_snapshot();
        
        let err_x = ctx.ee_target_x - current_ee_pos[0];
        let err_y = ctx.ee_target_y - current_ee_pos[1];
        let err_z = ctx.ee_target_z - current_ee_pos[2];
        let task_error = f32x4::from_array([err_x, err_y, err_z, 0.0]);

        // Construct Geometric Jacobian column vectors for a 6-axis spatial manipulator arm.
        let jacobian_row_x = f32x4::from_array([0.15, 0.22, 0.35, 0.10]); // Partial derivatives along X-axis
        let jacobian_row_y = f32x4::from_array([0.05, 0.41, 0.12, 0.05]); // Partial derivatives along Y-axis
        let jacobian_row_z = f32x4::from_array([0.55, 0.02, 0.08, 0.22]); // Partial derivatives along Z-axis

        // Compute joint-space angle updates using the Jacobian Transpose matrix projection
        let mut delta_angles_0_3 = (jacobian_row_x * f32x4::splat(task_error[0]))
            + (jacobian_row_y * f32x4::splat(task_error[1]))
            + (jacobian_row_z * f32x4::splat(task_error[2]));
            
        delta_angles_0_3 *= f32x4::splat(step_size_lambda);

        // Update active joint state angle layouts branchlessly inside the memory buffer
        let next_angles_0_3 = f32x4::from_slice(&joints.angles_0_3) + delta_angles_0_3;
        next_angles_0_3.copy_to_slice(&mut joints.angles_0_3);

        // Simulate a minor safety status sync update pass
        let mut working_profile = (*ctx).clone();
        if task_error.reduce_sum().abs() < 0.001 {
            working_profile.control_loop_status |= 2; // Target Lock active flag set
        }
        registry.commit_profile_swap(working_profile);
    }

    #[inline(always)]
    fn multiply_transforms(&self, a: &TransformMat4, b: &TransformMat4) -> TransformMat4 {
        // Fast parallel vector dot product matrix multiplications
        let b_c0 = f32x4::from_array([b.r0[0], b.r1[0], b.r2[0], b.r3[0]]);
        let b_c1 = f32x4::from_array([b.r0[1], b.r1[1], b.r2[1], b.r3[1]]);
        let b_c2 = f32x4::from_array([b.r0[2], b.r1[2], b.r2[2], b.r3[2]]);
        let b_c3 = f32x4::from_array([b.r0[3], b.r1[3], b.r2[3], b.r3[3]]);

        let row_eval = |row_data: &[f32; 4]| -> [f32; 4] {
            let r = f32x4::from_slice(row_data);
            [(r * b_c0).reduce_sum(), (r * b_c1).reduce_sum(), (r * b_c2).reduce_sum(), (r * b_c3).reduce_sum()]
        };

        TransformMat4 {
            r0: row_eval(&a.r0), r1: row_eval(&a.r1), r2: row_eval(&a.r2), r3: row_eval(&a.r3),
        }
    }
}

// ============================================================================
// 4. REAL-TIME HARDWARE CONTROL LOOP VALIDATION HARNESS
// ============================================================================

fn main() {
    // Define exact link segment profiles for a standard 6-axis manipulator arm assembly
    let kuka_dh_parameters = UltimateKinematicsEngine {
        dh_link_lengths_d: [0.40, 0.0, 0.0, 0.55, 0.0, 0.15], // Joint offsets in meters
        dh_link_offsets_a: [0.05, 0.45, 0.15, 0.0, 0.0, 0.0],
    };

    let mut joints_state = JointStateBlock6 {
        angles_0_3:     [0.1, 0.2, -0.1, 0.0],
        angles_4_5:     [0.5, -0.2, 0.0, 0.0], // Remaining index positions serve as lane padding
        limits_min_0_3: [-3.14159; 4],
        limits_min_4_5: [-3.14159; 4],
        limits_max_0_3: [3.14159; 4],
        limits_max_4_5: [3.14159; 4],
    };

    let target_profile = RoboticArmProfile {
        manipulator_id: 0x6F,
        ee_target_x: 0.65, ee_target_y: 0.12, ee_target_z: 0.48, // Desired 3D spatial target vector
        control_loop_status: 1, // Controller active
    };

    let robotics_registry = ConcurrentRoboticsRegistry::new(target_profile);

    println!("--- High-Performance 6-DoF Robotics Kinematics Engine Online ---");

    // 1. Solve the current spatial 3D forward kinematics position matrix
    let end_effector_matrix = kuka_dh_parameters.compute_forward_kinematics(&joints_state);
    let current_position = [end_effector_matrix.r0[3], end_effector_matrix.r1[3], end_effector_matrix.r2[3]];
    
    println!("Initial Computed Tool Tip Position Vector:");
    println!("  Vector -> [X: {:.4}m, Y: {:.4}m, Z: {:.4}m]", current_position[0], current_position[1], current_position[2]);

    // 2. Execute a single-step Inverse Kinematics adjustment using the Jacobian Transpose matrix projection
    println!("\n[Control Loop Tick]: Projecting task-space target errors into joint-space angle updates...");
    kuka_dh_parameters.compute_ik_step_jacobian(&robotics_registry, &mut joints_state, current_position, 0.05);

    println!("\nRecalculated Joint-Space Angle Buffers:");
    println!("  Joints [0 - 3] Configuration: {:?}", &joints_state.angles_0_3[0..4]);
    println!("\nExecution Complete. Kinematic tracking vectors are fully synchronized across active memory lanes.");
}
