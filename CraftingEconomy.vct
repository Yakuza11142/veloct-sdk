#![feature(portable_simd)] // Unlocks hardware-native SIMD vector extensions

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;

// ============================================================================
// 1. DATA CORE: HARDWARE-ALIGNED CONTIGUOUS LEDGER SLOTS
// ============================================================================

/// High-density material transaction block tracking 4 ingredients concurrently.
/// Padded to 64 bytes to prevent false-sharing across database execution workers.
#[derive(Debug, Clone, Copy)]
#[repr(C, align(64))]
pub struct TransactionIngredientBlock4 {
    pub required_material_ids: [u32; 4],
    pub required_quantities:    [f32; 4],
    pub player_current_stocks:  [f32; 4],
}

#[derive(Debug, Clone, Default)]
pub struct InventoryStateLedger {
    // Dynamic runtime balance allocations keyed directly to dynamic token IDs
    pub item_balances: std::collections::HashMap<u32, f32>,
}

// ============================================================================
// 2. THE LOCK-FREE READ-COPY-UPDATE TRANSACTION LAYER
// ============================================================================

/// A thread-safe, infinitely scalable inventory memory container.
/// Bypasses database Mutex blocking locks to ensure zero-latency high-frequency checkouts.
pub struct ConcurrentEconomyRegistry {
    active_ledger_ptr: AtomicPtr<InventoryStateLedger>,
}

impl ConcurrentEconomyRegistry {
    pub fn new(initial_ledger: InventoryStateLedger) -> Self {
        let boxed = Box::into_raw(Box::new(initial_ledger));
        Self { active_ledger_ptr: AtomicPtr::new(boxed) }
    }

    #[inline(always)]
    pub fn read_snapshot(&self) -> Arc<InventoryStateLedger> {
        let raw_ptr = self.active_ledger_ptr.load(Ordering::Acquire);
        unsafe { Arc::new((*raw_ptr).clone()) }
    }

    pub fn commit_transaction_swap(&self, new_ledger: InventoryStateLedger) {
        let new_raw_ptr = Box::into_raw(Box::new(new_ledger));
        let old_raw_ptr = self.active_ledger_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); }
        }
    }
}

impl Drop for ConcurrentEconomyRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_ledger_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING ATOMIC TRANSACTION PARALLEL EXECUTION CORE
// ============================================================================

pub struct SpatialCraftingLedgerEngine {
    pub output_result_item_id: u32,
    pub output_yield_quantity: f32,
}

impl SpatialCraftingLedgerEngine {
    /// PARALLEL TRANSACTION DRY-RUN (Validates 4 resource groups simultaneously)
    /// Completely branchless. Evaluates stock requirements via parallel register comparisons.
    #[inline(always)]
    pub fn execute_transactional_craft(
        &self,
        registry: &ConcurrentEconomyRegistry,
        requirements: &TransactionIngredientBlock4
    ) -> bool {
        let mut isolated_working_ledger = (*registry.read_snapshot()).clone();

        // 1. Load requirement constraints instantly into 128-bit SIMD lanes
        let req_ids = u32x4::from_slice(&requirements.required_material_ids);
        let req_qtys = f32x4::from_slice(&requirements.required_quantities);
        let stock_qtys = f32x4::from_slice(&requirements.player_current_stocks);

        // 2. Perform parallel vector validation step: Is stock >= requirement?
        // Generates a branchless lanes mask (-1 for true, 0 for false)
        let validation_mask = stock_qtys.simd_ge(req_qtys);

        // 3. Collapse lanes horizontally: if any lane returned false, abort the entire transaction
        if !validation_mask.all() {
            return false; // Transaction rejected: Insufficient ingredients
        }

        // 4. ATOMIC COMMIT PHASE: Safe to deduct resources without side-effect leaks
        let final_remaining_balances = stock_qtys - req_qtys;

        // Extract and write back values into our isolated database transaction node safely
        for i in 0..4 {
            if req_ids[i] != 0 {
                isolated_working_ledger.item_balances.insert(req_ids[i], final_remaining_balances[i]);
            }
        }

        // 5. Award the newly minted item asset to the player's balance registry
        let current_crafted_balance = *isolated_working_ledger.item_balances.get(&self.output_result_item_id).unwrap_or(&0.0);
        isolated_working_ledger.item_balances.insert(self.output_result_item_id, current_crafted_balance + self.output_yield_quantity);

        // 6. Swap state pointer configuration atomically to publish the new ledger balances across the cluster
        registry.commit_transaction_swap(isolated_working_ledger);
        true
    }
}

// ============================================================================
// 4. TRANSACTION LEDGER VERIFICATION RUNTIME
// ============================================================================

fn main() {
    // Populate an initial player wallet state mapping balances dynamically
    let mut initial_wallet = InventoryStateLedger::default();
    initial_wallet.item_balances.insert(101, 50.0); // 50 Gold Ore units
    initial_wallet.item_balances.insert(102, 12.0); // 12 Fire Essence units
    initial_wallet.item_balances.insert(501, 0.0);  // 0 Epic Swords crafted initially

    let central_bank_registry = ConcurrentEconomyRegistry::new(initial_wallet);

    // Set up a recipes structure demanding 4 parallel item checks
    let epic_sword_recipe = TransactionIngredientBlock4 {
        required_material_ids:, // Remaining fields are zero padding slots
        required_quantities:    [20.0, 5.0, 0.0, 0.0],
        player_current_stocks:  [50.0, 12.0, 0.0, 0.0],
    };

    let ledger_processor = SpatialCraftingLedgerEngine {
        output_result_item_id: 501, // Epic Sword ID
        output_yield_quantity: 1.0,  // Yield 1 item per loop run
    };

    println!("--- High-Throughput Concurrent Transaction Ledger Engine Online ---");
    println!("Initial Vault Item Balances: {:?}", central_bank_registry.read_snapshot().item_balances);

    // Execute the transaction loop
    let tx_success = ledger_processor.execute_transactional_craft(&central_bank_registry, &epic_sword_recipe);

    let final_balances = central_bank_registry.read_snapshot();
    println!("\nRecalculated Ledger Balances Post Atomic Crafting Commit Pass:");
    println!("  Transaction Verification Status : Success = {}", tx_success);
    println!("  Remaining Gold Ore Balance (101) : {} units (Expected 30.0)", final_balances.item_balances.get(&101).unwrap_or(&0.0));
    println!("  Remaining Fire Essence (102)     : {} units (Expected 7.0)", final_balances.item_balances.get(&102).unwrap_or(&0.0));
    println!("  Minted Epic Sword Balance (501)  : {} units (Successfully incremented)", final_balances.item_balances.get(&501).unwrap_or(&0.0));
}
