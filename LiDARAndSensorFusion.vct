#![feature(portable_simd)] // Unlocks native hardware SIMD vector extension instruction sets

use std::sync::atomic::{AtomicPtr, Ordering};
use std::sync::Arc;
use std::simd::f32x4;

// ============================================================================
// 1. DATA CORE: COMPACT STRUCTURE-OF-ARRAYS (SoA) SPATIAL TOPOLOGY
// ============================================================================

/// High-density packed 3D sensor cloud array tracking 4 point reflections concurrently.
/// Cache-aligned to 64 bytes to eliminate false sharing and memory-bus cross-talk.
#[derive(Debug, Clone, Copy)]
#[repr(C, align(64))]
pub struct LidarPointCloudSoA4 {
    pub x: [f32; 4],
    pub y: [f32; 4],
    pub z: [f32; 4],
    pub intensity: [f32; 4],
}

/// A contiguous, memory-aligned 2D Robotic Occupancy Map buffer.
/// Aligned to 64 bytes to allow instant GPU constant buffer memory mapping across PCIe lanes.
#[derive(Debug, Clone)]
#[repr(C, align(64))]
pub struct OccupancyGridBuffer {
    /// Stores log-odds probability states: 0 = Free, 127 = Unknown, 255 = Absolute Solid Occupied
    pub cell_probability_matrix: Vec<u8>,
    pub grid_resolution_meters: f32,
    pub width_cells: usize,
    pub height_cells: usize,
    pub sequence_frame_id: u64,
}

impl OccupancyGridBuffer {
    #[inline(always)]
    pub fn is_cell_occupied(&self, x: usize, y: usize) -> bool {
        if x >= self.width_cells || y >= self.height_cells { return true; } // Out of bounds safety barrier
        let structural_idx = x + (y * self.width_cells);
        self.cell_probability_matrix[structural_idx] > 127
    }
}

// ============================================================================
// 2. THE LOCK-FREE RECENT CONTEXT REGISTRY (URCU)
// ============================================================================

/// Thread-safe, lock-free global robot perception registry.
/// Thousands of parallel pathfinding worker nodes, costmap generators, and motion
/// systems can query current spatial fields concurrently with absolute zero read latency.
pub struct ConcurrentPerceptionRegistry {
    active_grid_ptr: AtomicPtr<OccupancyGridBuffer>,
}

impl ConcurrentPerceptionRegistry {
    pub fn new(initial_grid: OccupancyGridBuffer) -> Self {
        let boxed = Box::into_raw(Box::new(initial_grid));
        Self { active_grid_ptr: AtomicPtr::new(boxed) }
    }

    /// LOCK-FREE GRID SNAPSHOT READ (Hot Path Worker Read)
    #[inline(always)]
    pub fn read_grid_snapshot(&self) -> Arc<OccupancyGridBuffer> {
        let raw_ptr = self.active_grid_ptr.load(Ordering::Acquire);
        unsafe { Arc::new((*raw_ptr).clone()) }
    }

    /// ATOMIC COMMIT PHASE (Transaction Swap Guard)
    pub fn commit_grid_transaction(&self, fresh_grid: OccupancyGridBuffer) {
        let new_raw_ptr = Box::into_raw(Box::new(fresh_grid));
        let old_raw_ptr = self.active_grid_ptr.swap(new_raw_ptr, Ordering::Release);
        if !old_raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(old_raw_ptr); } // Clear out historical allocation memory blocks
        }
    }
}

impl Drop for ConcurrentPerceptionRegistry {
    fn drop(&mut self) {
        let raw_ptr = self.active_grid_ptr.load(Ordering::Relaxed);
        if !raw_ptr.is_null() {
            unsafe { let _ = Box::from_raw(raw_ptr); }
        }
    }
}

// ============================================================================
// 3. THE UNCHANGING PERCEPTION INGESTION CORE (SIMD SPATIAL ACCELERATOR)
// ============================================================================

pub struct UltimateSensorFusionEngine;

impl UltimateSensorFusionEngine {
    /// PARALLEL VECTORIZED LIDAR INGESTION MATRIX (Updates 4 telemetry points simultaneously)
    /// Converts continuous 3D world coordinates onto discrete, fast-lookup grid buckets branchlessly.
    /// Employs a non-destructive probability modifier pass to filter out sensor noise.
    #[inline(always)]
    pub fn integrate_point_cloud_blockx4(
        &self,
        registry: &ConcurrentPerceptionRegistry,
        point_chunk: &LidarPointCloudSoA4
    ) {
        let mut working_grid = (*registry.read_grid_snapshot()).clone();

        // 1. Load active data tracks directly into 128-bit hardware vector registers
        let pt_x = f32x4::from_slice(&point_chunk.x);
        let pt_z = f32x4::from_slice(&point_chunk.z);

        // 2. Broadcast spatial transformation constants across vector registers
        let res_vec = f32x4::splat(working_grid.grid_resolution_meters);
        let center_offset = f32x4::splat(16.0); // Shift coordinates to local center reference markers

        // 3. Calculate grid index mappings branchlessly via vector math steps
        let mapped_x = (pt_x / res_vec) + center_offset;
        let mapped_y = (pt_z / res_vec) + center_offset;

        // Clamp values to safe coordinate boundary limits branchlessly
        let max_w = f32x4::splat((working_grid.width_cells - 1) as f32);
        let max_h = f32x4::splat((working_grid.height_cells - 1) as f32);
        let zero  = f32x4::splat(0.0);

        let final_grid_x = mapped_x.simd_clamp(zero, max_w);
        let final_grid_y = mapped_y.simd_clamp(zero, max_h);

        // 4. LOG-ODDS PROBABILITY OCCUPANCY UPDATE PASS
        // Instead of hard-overwriting values, we increment log-odds states branchlessly.
        // This ensures tracking filters out transient telemetry data reflections and noise artifacts.
        for lane in 0..4 {
            let gx = final_grid_x[lane] as usize;
            let gy = final_grid_y[lane] as usize;
            let structural_idx = gx + (gy * working_grid.width_cells);

            let current_log_odds = working_grid.cell_probability_matrix[structural_idx] as u32;
            // Accumulate belief states, capping maximum saturation bounds to absolute solid (255)
            let updated_log_odds = (current_log_odds + 45).min(255);
            working_grid.cell_probability_matrix[structural_idx] = updated_log_odds as u8;
        }

        working_grid.sequence_frame_id += 1;

        // Swap state pointer configurations atomically to publish updates across navigation systems
        registry.commit_grid_transaction(working_grid);
    }
}

// ============================================================================
// 4. AUTONOMOUS ROBOTICS SYSTEMS VALIDATION HARNESS
// ============================================================================

fn main() {
    // Allocate a small 32x32 spatial occupancy costmap matrix buffer block
    let base_costmap = OccupancyGridBuffer {
        cell_probability_matrix: vec![127; 1024], // Start completely initialized to Unknown (127)
        grid_resolution_meters: 0.5,             // 50cm per cell tracking fidelity accuracy
        width_cells: 32,
        height_cells: 32,
        sequence_frame_id: 0,
    };

    let perception_registry = ConcurrentPerceptionRegistry::new(base_costmap);
    let sensor_fusion_engine = UltimateSensorFusionEngine;

    // Simulate an incoming 3D LiDAR point cloud snapshot array packet
    // Targets 1 & 2 hit close points, testing localized density stacking mechanics
    let streaming_lidar_chunk = LidarPointCloudSoA4 {
        x: [2.5, 2.7, -4.0, 1.2],
        y: [0.0; 4],
        z: [4.0, 4.1, -1.5, 0.5],
        intensity: [1.0; 4],
    };

    println!("--- High-Throughput Cyber-Physical Robotics Perception Core Active ---");
    println!("Initial State Sequence Frame Token: ID = {}", perception_registry.read_grid_snapshot().sequence_frame_id);

    // Run the parallelized vector spatial verification update step
    sensor_fusion_engine.integrate_point_cloud_blockx4(&perception_registry, &streaming_lidar_chunk);

    let updated_snapshot = perception_registry.read_grid_snapshot();
    println!("\nRecalculated Sensor-Fusion Costmap Diagnostics:");
    println!("  Active Perception Sequence Frame ID : {}", updated_snapshot.sequence_frame_id);
    // Query exact cell index to confirm log-odds probability tracking accumulation
    let check_x = ((2.5 / 0.5) + 16.0) as usize;
    let check_y = ((4.0 / 0.5) + 16.0) as usize;
    println!("  Target Occupancy Cell Value [{}, {}]  : {} (Log-Odds incremented safely past noise floors)", 
             check_x, check_y, updated_snapshot.cell_probability_matrix[check_x + (check_y * 32)]);
    println!("  Obstacle Verification Status Guard : Solid = {} (Ready for Pathfinding Vector Mapping)", 
             updated_snapshot.is_cell_occupied(check_x, check_y));
}
