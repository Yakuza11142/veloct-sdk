module World.Streaming;

struct SectorGrid {
    grid_x: i32,
    grid_z: i32,
    lod_level: u8,
    is_loaded: bool
}

public system WorldStreamingSystem {
    query: (mut SectorGrid, Transform),
    override fn update(dt: f32, pipeline: mut Pipeline) {
        pipeline.parallel_for(query, fn(mut sector, transform) {
            let dist = math_sqrt(transform.position.x * transform.position.x + transform.position.z * transform.position.z);
            if dist < 500.0 { sector.lod_level = 0; sector.is_loaded = true; }
            else if dist < 1500.0 { sector.lod_level = 1; sector.is_loaded = true; }
            else { sector.is_loaded = false; }
        });
    }
}
