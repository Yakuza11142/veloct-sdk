module Spatial.Interaction;

struct PinchGesture {
    is_pinching: bool,
    pinch_distance: f32,
    pinch_center: vec3
}

public system InteractionPipeline {
    // Multi-Finger Pinch Bounds Detector
    public fn detect_pinch_gesture(thumb_tip: vec3, index_tip: vec3) -> PinchGesture {
        let dist = vec3_distance(thumb_tip, index_tip);
        return PinchGesture {
            is_pinching: dist < 0.02, // Less than 2 cm threshold
            pinch_distance: dist,
            pinch_center: (thumb_tip + index_tip) * 0.5
        };
    }

    // Floating 3D Canvas Ray Hit Testing
    public fn raycast_ui_panel(ray_origin: vec3, ray_dir: vec3, panel_center: vec3, panel_normal: vec3) -> vec2 {
        let t = math_dot(panel_center - ray_origin, panel_normal) / math_dot(ray_dir, panel_normal);
        let hit_pt = ray_origin + ray_dir * t;
        return vec2(hit_pt.x - panel_center.x, hit_pt.y - panel_center.y);
    }

    // Binaural HRTF Spatial Audio Placement
    public fn compute_hrtf_pan(source_pos: vec3, listener_pose: mat4, mut left_gain: mut f32, mut right_gain: mut f32) {
        let local_source = mat4_mul_vec3(mat4_inverse(listener_pose), source_pos);
        let angle = math_atan2(local_source.x, local_source.z);
        left_gain  = math_clamp(0.5 - angle * 0.5, 0.0, 1.0);
        right_gain = math_clamp(0.5 + angle * 0.5, 0.0, 1.0);
    }
}
